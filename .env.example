# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，不要提交
POSTGRES_DB=mostar
POSTGRES_USER=mostar
POSTGRES_PASSWORD=请生成一个强密码

# 可选：scripts/import_knowledge.py 使用的连接参数
PGHOST=localhost
PGPORT=5432
PGDATABASE=mostar
PGUSER=mostar
PGPASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=knowledge-base
MINIO_USE_SSL=false

# 主模型（阿里云百炼 OpenAI 兼容模式）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
OPENAI_MODEL=qwen3.7-flash
DASHSCOPE_API_KEY=必填

# 知识库向量模型（SiliconFlow，768 维）
SILICONFLOW_API_KEY=RAG 需要向量检索时必填

# 可选：联网搜索 / 高德
SEARCHAPI_API_KEY=
AMAP_API_KEY=


# 管理/诊断接口令牌（生产建议生成 32 位以上随机字符串）
MOSTAR_ADMIN_TOKEN=
MOSTAR_ADMIN_TOKEN_REQUIRED=true
MOSTAR_CHAT_TOKEN_REQUIRED=false
MOSTAR_CHAT_REQUESTS_PER_MINUTE=20
